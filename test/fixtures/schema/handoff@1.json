{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A handoff's frontmatter: the state one working session leaves the next",
  "type": "object",
  "required": ["schema", "title", "date"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "handoff@1" },
    "title": { "$ref": "defs@1.json#/$defs/title" },
    "date": { "$ref": "defs@1.json#/$defs/date" },
    "links": { "$ref": "defs@1.json#/$defs/links" }
  }
}
